{
  "ConnectionStrings": {
    "Bitacora": "Data Source=bitacora.db"
  },
  "Jwt": {
    "Issuer": "Bitacora.Api",
    "Audience": "Bitacora.App",
    "ExpiraMinutos": 10
  },
  "HttpsPort": 7080,
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      },
      "Https": {
        "Url": "https://0.0.0.0:7080"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
