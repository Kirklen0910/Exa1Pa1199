            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Se crea con rol Usuario y sin exponer la contraseña', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.rol).to.eql('Usuario');",
                  "  pm.expect(b).to.not.have.property('password');",
                  "  pm.expect(b).to.not.have.property('passwordHash');",
