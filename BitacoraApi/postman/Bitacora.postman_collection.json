                  "const t = pm.collectionVariables.get('tokenUsuario');",
                  "const partes = t.split('.');",
                  "const payload = JSON.parse(atob(partes[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "payload.role = 'Admin';",
                  "const nuevo = btoa(JSON.stringify(payload)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "pm.collectionVariables.set('tokenAlterado', partes[0] + '.' + nuevo + '.' + partes[2]);"
                ]
              }
            },
